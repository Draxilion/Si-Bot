# Required: token the app uses to talk to the server. Generate with: openssl rand -hex 32
SIBOT_TOKEN=change-me

# Postgres
POSTGRES_PASSWORD=sibot
DATABASE_URL=postgres://sibot:sibot@localhost:5432/sibot

# Providers: fill any you have. Unset ones are hidden in the app.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# opencode bridge: run `opencode serve` and point here (Phase 2)
OPENCODE_URL=

# Model used for background memory extraction (provider:model)
MEMORY_MODEL=anthropic:claude-haiku-5-5
DEFAULT_MODEL=anthropic:claude-sonnet-5-5

# VPS only: your domain for automatic HTTPS
DOMAIN=localhost
