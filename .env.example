# Required: token the app uses to talk to the server. Generate with: openssl rand -hex 32
SIBOT_TOKEN=change-me

# Postgres
POSTGRES_PASSWORD=sibot
DATABASE_URL=postgres://sibot:sibot@localhost:5432/sibot

# Providers: fill any you have. Unset ones are hidden in the app.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# Web search: SearXNG runs in compose (no key needed). Set BRAVE_API_KEY to use Brave Search instead.
SEARXNG_SECRET=change-me-searxng-secret
BRAVE_API_KEY=

# OpenCode Go subscription key (opencode.ai). Adds DeepSeek V4.1 Flash and V4 Pro; more via EXTRA_MODELS,
# e.g. EXTRA_MODELS=opencode:<model-id>=<Label>
OPENCODE_API_KEY=

# Model used for background memory extraction (provider:model)
# Embeddings for semantic recall (provider:model). Defaults to openai:text-embedding-3-small when OPENAI_API_KEY is set.
# Without one, recall uses keyword search only. Local option: ollama:nomic-embed-text
EMBEDDING_MODEL=
MEMORY_MODEL=anthropic:claude-haiku-5-5
DEFAULT_MODEL=anthropic:claude-sonnet-5-5

# VPS only: your domain for automatic HTTPS
DOMAIN=localhost
